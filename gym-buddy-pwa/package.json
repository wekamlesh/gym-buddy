{
  "name": "gym-buddy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "dev": "npm run build && node scripts/dev.mjs",
    "dev:cloudflare": "npm run build && wrangler pages dev dist --port 8788",
    "db:local": "wrangler d1 migrations apply gym-buddy --local",
    "db:remote": "wrangler d1 migrations apply gym-buddy --remote --config wrangler.production.json",
    "configure": "node scripts/configure.mjs",
    "profile:remote": "node scripts/seed-profile.mjs --remote",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:meal-photo": "node tests/meal-photo-browser.mjs",
    "test:ai": "node tests/ai-browser.mjs",
    "test:exercises": "node tests/exercises-browser.mjs",
    "test:dashboard": "node tests/dashboard-browser.mjs",
    "test:forms": "node tests/forms-browser.mjs"
  },
  "dependencies": { "jose": "^6.1.0" },
  "devDependencies": { "@playwright/test": "^1.56.0", "wrangler": "^4.45.0" }
}
